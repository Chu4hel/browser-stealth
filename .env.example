# Конфигурация окружения для browser-stealth
# Внимание: не коммитьте реальные учетные данные в git!

# Прокси для E2E и Heavy тестов против Cloudflare / антифрод стендов
# Поддерживаются форматы:
#   http://user:password@host:port
#   https://user:password@host:port
#   socks5://user:password@host:port
# В GitHub Actions / GitLab CI этот параметр задается через Secret: TEST_PROXY
TEST_PROXY=
# Альтернативные переменные:
# E2E_PROXY=
# PROXY_URL=
